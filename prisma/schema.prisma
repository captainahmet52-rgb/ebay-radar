// CLAUDE.md Bölüm 6 şemasının Prisma karşılığı

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ─── Kullanıcılar (kiracılar) ─────────────────────────────────────────────────
model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String
  // starter | basic | growth | pro | enterprise
  plan                 String   @default("starter")
  role                 String   @default("user") // user | admin
  productLimit         Int      @default(300)    // pakete göre atanır
  lemonSqueezySubscriptionId String?
  createdAt            DateTime @default(now())

  ebayAccounts         EbayAccount[]
  listings             Listing[]
  orders               Order[]
  productDistributions ProductDistribution[]

  // AmazonBot (AliExpress → Amazon)
  amazonAccounts       AmazonAccount[]
  amazonListings       AmazonListing[]
  amazonOrders         AmazonOrder[]
  amazonAutoUploadLogs AmazonAutoUploadLog[]
  creditTransactions   CreditTransaction[]

  // ShopifyBot (AliExpress → müşterinin Shopify mağazası)
  shopifyAccounts      ShopifyAccount[]
  shopifyListings      ShopifyListing[]
  shopifyOrders        ShopifyOrder[]

  // Ön ödemeli kredi cüzdanı (takip kodu çevirme vb. mikro-ücretler buradan düşer)
  creditBalanceUsd     Float    @default(0)

  // AmazonBot oto-yükleme + müşteri kuralları (eBay auto-upload'ın Amazon karşılığı)
  amazonAutoUploadEnabled  Boolean @default(false)
  // Eskiden sabit 03:00 UTC cron TÜM kullanıcılar için çalışırdı — artık eBay
  // tarafındaki gerçek zamanlama mantığıyla (lib/auto-upload-schedule.ts) aynı
  // desen: worker saatte bir "nabız" alır, kullanıcı burada seçtiği sıklıkta çalışır.
  amazonUploadSchedule     String  @default("daily")
  amazonUploadScheduleHour Int     @default(3)
  amazonUploadDailyLimit   Int     @default(10)
  amazonUploadMinCostUsd   Float   @default(8)   // AliExpress kaynak maliyeti alt sınırı
  amazonUploadMaxCostUsd   Float   @default(100) // üst sınır
  amazonUploadQuantity     Int     @default(2)
  amazonUploadAutoPublish  Boolean @default(true)
  // Satış olunca AliExpress'e otomatik sipariş ver (oto-buy)
  amazonAutoFulfill        Boolean @default(false)
  // Pazar başına MÜŞTERİ marj override (null → pazar varsayılanı: us %20, uk/ae %25, sa %30)
  amazonMarginUsPct        Float?
  amazonMarginUkPct        Float?
  amazonMarginAePct        Float?
  amazonMarginSaPct        Float?

  // Otomatik Yükleme Ayarları
  autoUploadEnabled     Boolean  @default(false)
  uploadSchedule        String   @default("daily")
  uploadScheduleHour    Int      @default(9)
  uploadDailyLimit      Int      @default(10)
  uploadMinProfit       Float    @default(2)
  uploadMinMarginPct    Float    @default(10)
  uploadMinAmazonPrice  Float    @default(0)
  uploadMaxAmazonPrice  Float    @default(150)
  uploadPrimeOnly       Boolean  @default(false)
  uploadSoldWithinDays  Int?
  uploadSourceMarket    String   @default("US")
  uploadEbaySite        String   @default("EBAY_US")
  uploadProfitMarginPct Float    @default(30)
  uploadQuantity        Int      @default(1)
  uploadAutoPublish     Boolean  @default(true)
  // eBay sipariş gelince otomatik takip al (TrackCaptain) + eBay'e yükle (cüzdandan $0.43)
  ebayAutoFulfill       Boolean  @default(false)

  // ─── Uluslararası / çapraz pazar maliyetleri (src/lib/cross-market.ts) ─────
  // eBay uluslararası işlem ücreti % — kayıt ülkesine göre (TR "Rest of World" %1.55)
  ebayIntlFeePct        Float    @default(1.55)
  // eBay kur çevrim ücreti % — payout USD değilse USD-dışı pazarlarda uygulanır (TR %3)
  ebayFxFeePct          Float    @default(3.0)
  // Çapraz kaynak yüzde tamponu % (gümrük/import) — Amazon pazarı ≠ eBay pazarı iken
  crossExtraPct         Float    @default(0)
  // Çapraz kaynak sabit tamponu (KAYNAK pazar para biriminde — uluslararası kargo)
  crossExtraFixed       Float    @default(0)

  // Trial (eBay) — bir kez set edilir, asla sıfırlanmaz (ömür boyu 1 deneme).
  trialEndsAt DateTime?
  // Trial (Amazon) — eBay'den BAĞIMSIZ ayrı bir "ömür boyu 1 deneme" bayrağı
  // (iki farklı ürün/hizmet, her biri kendi ücretsiz denemesini hak eder).
  amazonTrialEndsAt DateTime?

  // ─── Referans (davet) sistemi ──────────────────────────────────────────────
  referralCode       String?  @unique          // bu kullanıcının paylaştığı davet kodu
  referredById       String?                    // bu kullanıcıyı davet eden kişi
  referralRewardDays Int      @default(0)        // biriken bonus gün (mağaza denemesine eklenir)
  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("UserReferrals")
  couponRedemptions CouponRedemption[]

  // ─── Affiliate (ortaklık — komisyonlu tanıtım) ─────────────────────────────
  isAffiliate         Boolean @default(false)  // admin onaylar
  commissionRatePct   Float   @default(0)        // ör. 20 = %20 komisyon
  commissionBalanceUsd Float  @default(0)        // biriken (ödenmemiş) komisyon

  // NextAuth
  accounts Account[]
  sessions Session[]
  autoUploadLogs AutoUploadLog[]

  // Mevcut eBay ilanlarını içe aktarma (mağaza bağlanınca eski ilanları çek + stok takibi)
  listingImports   ListingImport[]
  importedListings ImportedListing[]
}

// ─── Bağlı eBay mağazaları ────────────────────────────────────────────────────
model EbayAccount {
  id                    String    @id @default(cuid())
  userId                String
  ebayUserId            String
  // Mağazanın bağlı olduğu eBay pazarı — bağlanırken Identity API'den otomatik tespit edilir.
  // EBAY_US | EBAY_GB | EBAY_DE | EBAY_AU
  marketplace           String    @default("EBAY_US")
  // Token'lar ŞİFRELİ saklanır — Node crypto (AES-256-GCM). Düz metin ASLA.
  oauthTokenEncrypted   String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  fulfillmentPolicyId   String?
  paymentPolicyId       String?
  returnPolicyId        String?
  merchantLocationKey   String?
  policiesCheckedAt     DateTime?
  // Mağaza otomasyon anahtarı. Bağlanınca 7 günlük deneme ile AKTİF gelir.
  // Süre (deneme veya paket) bitince freeze-stores worker'ı false yapar.
  // Sadece isActive mağazalara ürün yüklenir / otomasyon çalışır.
  isActive              Boolean   @default(false)
  activatedAt           DateTime?
  // Mağaza başına 7 günlük ücretsiz deneme bitiş tarihi (bağlanınca set edilir).
  trialEndsAt           DateTime?
  // Ücretli erişim bitiş tarihi (paket alınca +30 gün; admin comp'ta uzak gelecek).
  // now < paidUntil → ücretli aktif; yoksa deneme/dondurma durumuna bakılır.
  paidUntil             DateTime?
  // PAKET = MAĞAZA: her mağaza KENDİ aboneliğine sahiptir. Bu mağazanın paketi ve
  // o pakete ait ürün limiti burada tutulur (kullanıcı-başına değil, mağaza-başına).
  // Aktivasyonda (Lemon Squeezy checkout / admin comp) set edilir.
  plan                  String    @default("starter")
  productLimit          Int       @default(300)
  createdAt             DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  // Bu mağazadan içe aktarılan mevcut ilanlar + import çalışmaları
  listingImports   ListingImport[]
  importedListings ImportedListing[]
}

// ─── eBay deneme geçmişi (bedava deneme suistimal koruması) ──────────────────
// Her eBay mağazası (immutable ebayUserId) GLOBAL olarak yalnızca BİR kez bedava
// deneme alabilir. Mağaza başka bir hesaba (user) yeniden bağlansa bile burada
// kaydı varsa artık bedava deneme YOK — ama parayla aktive edilebilir.
// (Kullanıcı başına "ömür boyu 1 deneme" kuralı ise User.trialEndsAt ile zorlanır:
//  bir kez set edilir, asla sıfırlanmaz → ikinci mağaza bedava deneme alamaz.)
model EbayTrialHistory {
  id         String   @id @default(cuid())
  ebayUserId String   @unique // global tekil — bu mağaza zaten deneme kullandı mı?
  userId     String?  // denemeyi ilk kullanan hesap (bilgi/iz amaçlı, FK değil)
  usedAt     DateTime @default(now())

  @@index([userId])
}

// ─── Ürün deposu (ASIN bazlı) ─────────────────────────────────────────────────
model Product {
  id                  String    @id @default(cuid())
  asin                String    @unique
  title               String?
  category            String?
  imageUrl            String?
  // US | UK
  amazonMarket        String    @default("US")
  amazonPrice         Float?
  // in_stock | low | out
  amazonStockStatus   String    @default("in_stock")
  amazonStockQty      Int?      // "only N left" sinyali
  ebayFeeRate         Float     @default(0.136)  // Kategoriye göre değişir
  targetMargin        Float     @default(0.20)
  floorPrice          Float?
  calculatedEbayPrice Float?
  // hot | normal | dead
  pollTier            String    @default("normal")
  lastScrapedAt       DateTime?
  // Bu ürünün herhangi bir mağazada en son satıldığı an (satış-hızına göre tier için)
  lastSoldAt          DateTime?
  // active | paused
  status              String    @default("active")
  // Neden duraklatıldı? out_of_stock | low_stock | price_spike | floor | stale | manual
  // (auto-recovery yalnız stok/fiyat kaynaklı duraklatmaları yeniden açar; manual'a dokunmaz)
  pauseReason         String?
  // Üst üste başarısız tarama sayısı + son tarama hatası (bayat-veri koruması + gözlem)
  scrapeFailCount     Int       @default(0)
  lastScrapeError     String?
  createdAt           DateTime  @default(now())

  listings       Listing[]
  stockSnapshots StockSnapshot[]
  // Bu ASIN'e (SKU üzerinden) eşleşmiş, içe aktarılmış eBay ilanları
  importedListings ImportedListing[]

  @@index([status, pollTier, lastScrapedAt])
  @@index([status, pauseReason, lastScrapedAt])
  @@index([status, lastSoldAt])
}

// ─── Stok/fiyat geçmişi (her başarılı taramada bir kayıt) ─────────────────────
// Flapping (açıl-kapan) tespiti, "neden duraklatıldı" debug ve trend grafiği için.
model StockSnapshot {
  id          String   @id @default(cuid())
  productId   String
  amazonPrice Float?
  // in_stock | low | out | unknown
  stockStatus String
  stockQty    Int?
  ebayPrice   Float?
  // poll | verify | recovery
  source      String   @default("poll")
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
}

// ─── Kullanıcı listelemeleri ──────────────────────────────────────────────────
model Listing {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  ebayAccountId String
  ebayListingId String?  // eBay marketplace listing ID / legacy ItemID (publish sonrası döner)
  ebaySku       String?  // Inventory item SKU — bulk_update_price_quantity için
  ebayOfferId   String?  // Offer ID — fiyat güncellemesi için
  // İçe aktarılmış ESKİ (legacy) eBay ilanı mı? true → fiyat/stok Trading API
  // ReviseInventoryStatus (ItemID üzerinden) ile yazılır; Inventory API DEĞİL.
  isLegacy      Boolean  @default(false)
  // EBAY_US | EBAY_GB
  ebaySite      String   @default("EBAY_US")
  currentQty    Int      @default(2)
  currentPrice  Float?
  // Bu listeye özel kâr marjı (yüzde) — toplu yüklemede o partinin marjı. Yoksa kullanıcı/ürün marjı.
  marginPct     Float?
  publishStage  String?
  lastEbayError String?
  // active | paused | ended | draft
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ebayAccount EbayAccount @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)
  orders      Order[]
  distribution ProductDistribution?
}

// ─── Siparişler ───────────────────────────────────────────────────────────────
model Order {
  id                String    @id @default(cuid())
  userId            String
  listingId         String
  ebayOrderId       String?
  soldPrice         Float?
  amazonPriceAtSale Float?
  netProfit         Float?
  ebayFulfillmentId String?
  // eBay sipariş satır kalemi (kargo bildirimi için gerekli — poll-orders'ta kaydedilir)
  ebayLineItemId    String?
  // TrackCaptain'dan alınıp eBay'e yüklenen geçerli takip
  trackingNumber    String?
  carrierCode       String?   // usps | fedex
  shippedAt         DateTime?
  cancellationReason String?
  verifiedAt        DateTime?
  // pending | verified | cancelled | fulfilled
  fulfillmentStatus String    @default("pending")

  // ─── Managed Fulfillment (admin kaynaklı: biz Amazon'dan alırız) ───────────
  // Akış: awaiting_admin → awaiting_order_payment → awaiting_tracking_payment → completed
  managedStatus     String?
  // eBay'den çekilen alıcı kargo adresi (PII — SADECE admin görür, Amazon'dan almak için)
  shipToName        String?
  shipToLine1       String?
  shipToLine2       String?
  shipToCity        String?
  shipToState       String?
  shipToZip         String?
  shipToCountry     String?
  shipToPhone       String?
  // Admin girer: Amazon ürün maliyeti + markup + Amazon'dan aldığı takip no
  sourceCostUsd     Float?
  markupUsd         Float?
  amazonTrackingNo  String?
  // Kullanıcı ödemeleri (cüzdandan)
  orderChargePaidAt    DateTime?  // sipariş maliyeti + markup ödendi
  trackingChargePaidAt DateTime?  // takip ücreti ödendi → takip no reveal

  createdAt         DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)

  // Çift sipariş koruması — DB seviyesinde UNIQUE (userId, ebayOrderId).
  // Webhook + poll-orders aynı siparişi yakalasa bile fiziksel olarak iki kez yazılamaz
  // (race-safe; uygulama findFirst guard'ı yetişmese bile DB reddeder). ebayOrderId NULL
  // olanlar (manuel sipariş) hariç — Postgres NULL'ları distinct sayar. Migration önce
  // mevcut duplike'leri temizler (en eski kayıt tutulur), sonra index'i kurar.
  @@unique([userId, ebayOrderId])
  @@index([managedStatus])
}

// ─── NextAuth zorunlu tablolar ────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Otomatik Yükleme Geçmişi ────────────────────────────────────────────────
model AutoUploadLog {
  id               String   @id @default(cuid())
  userId           String
  status           String   // success | partial | failed
  productsUploaded Int      @default(0)
  productsSkipped  Int      @default(0)
  productsChecked  Int      @default(0)
  errorMessage     String?
  ranAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Ortak Ürün Deposu ────────────────────────────────────────────────────────
model DepotProduct {
  id                  String    @id @default(cuid())
  asin                String    @unique
  title               String?
  imageUrl            String?
  category            String?
  // US | UK
  amazonMarket        String    @default("US")
  amazonPrice         Float?
  amazonStockStatus   String    @default("in_stock")
  amazonStockQty      Int?
  ebayFeeRate         Float     @default(0.136)
  calculatedEbayPrice Float?
  // Talep + kârlılık + rekabetçilik sinyalleri
  soldCount           Int?      // rakip eBay mağazasının sattığı adet (talep kanıtı)
  // Rakipte EN SON gözlenen satış anı (Radar snapshot deltasından) — oto
  // yüklemenin "son X günde satılmış" filtresi bunu kullanır (sıcak ürün).
  lastSoldAt          DateTime?
  competitorPrice     Float?    // rakibin eBay satış fiyatı (rekabetçilik için)
  projectedProfit     Float?    // ekleme-anı net kâr (repricer)
  projectedMarginPct  Float?    // ekleme-anı net marj
  rankScore           Float     @default(0) // dağıtım sırası: kâr × talep × rekabetçilik
  lastScrapedAt       DateTime?
  status              String    @default("active")
  createdAt           DateTime  @default(now())

  distributions   ProductDistribution[]

  @@index([status, rankScore])
}

// ═══════════════════════════════════════════════════════════════════════════════
// AmazonBot (AliExpress → Amazon dropshipping) — eBay tarafından BAĞIMSIZ kendi dünyası
// ═══════════════════════════════════════════════════════════════════════════════

// AutoUploadLog'un (eBay) Amazon karşılığı — /amazon/auto-upload sayfasındaki
// "Yükleme Geçmişi" tablosu bunu okur.
model AmazonAutoUploadLog {
  id               String   @id @default(cuid())
  userId           String
  status           String   // success | partial | failed
  productsUploaded Int      @default(0)
  productsSkipped  Int      @default(0)
  productsChecked  Int      @default(0)
  errorMessage     String?
  ranAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Bağlı Amazon satıcı hesapları ────────────────────────────────────────────
model AmazonAccount {
  id                         String    @id @default(cuid())
  userId                     String
  sellerId                   String    // Amazon Seller ID (SP-API)
  // Hesabın pazarı — bağlanırken SP-API getMarketplaceParticipations ile OTOMATİK tespit
  // us | uk | ae | sa
  market                     String    @default("us")
  // SP-API token'ları ŞİFRELİ saklanır — Node crypto (AES-256-GCM). Düz metin ASLA.
  spapiRefreshTokenEncrypted String?   @db.Text
  spapiAccessTokenEncrypted  String?   @db.Text
  tokenExpiresAt             DateTime?
  // PAKET = HESAP (eBay'deki EbayAccount ile AYNI desen, bkz. src/lib/plans.ts +
  // src/lib/store-access.ts). Bağlanınca 7 günlük deneme ile AKTİF gelir.
  // Süre (deneme veya paket) bitince freeze-amazon-accounts worker'ı false yapar.
  // Sadece isActive hesaplara ürün yüklenir / otomasyon çalışır.
  isActive                   Boolean   @default(false)
  activatedAt                DateTime?
  // Hesap başına 7 günlük ücretsiz deneme bitiş tarihi (bağlanınca set edilir).
  trialEndsAt                DateTime?
  // Ücretli erişim bitiş tarihi (paket alınca +30 gün; admin comp'ta uzak gelecek).
  paidUntil                  DateTime?
  // PAKET = HESAP: bu hesabın paketi ve o pakete ait ürün limiti burada tutulur
  // (kullanıcı-başına değil, hesap-başına). Aktivasyonda (LS checkout / admin comp) set edilir.
  plan                       String    @default("starter")
  productLimit               Int       @default(300)
  createdAt                  DateTime  @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings AmazonListing[]

  @@index([userId])
}

// ─── Amazon deneme geçmişi (bedava deneme suistimal koruması, EbayTrialHistory'nin eşi) ──
// Her Amazon satıcı hesabı (immutable sellerId) GLOBAL olarak yalnızca BİR kez bedava
// deneme alabilir. Kullanıcı başına "ömür boyu 1 deneme" kuralı User.amazonTrialEndsAt
// ile zorlanır — eBay'den BAĞIMSIZ ayrı bir deneme hakkı (iki farklı ürün/hizmet).
model AmazonTrialHistory {
  id       String   @id @default(cuid())
  sellerId String   @unique // global tekil — bu hesap zaten deneme kullandı mı?
  userId   String?  // denemeyi ilk kullanan hesap (bilgi/iz amaçlı, FK değil)
  usedAt   DateTime @default(now())

  @@index([userId])
}

// ─── AmazonBot kendi deposu (AliExpress kaynağı, radar ile doldurulur) ────────
model AmazonDepotProduct {
  id                 String    @id @default(cuid())
  aliId              String    @unique // AliExpress ürün ID
  title              String?
  imageUrl           String?
  category           String?
  brand              String?
  brandSafe          Boolean   @default(true) // marka/yasak filtresinden geçti mi
  // AliExpress kaynağı USD cinsinden (pazara çevrim fiyatlama anında yapılır)
  aliCostUsd         Float
  aliShippingUsd     Float     @default(0)
  aliOrders          Int       @default(0)
  aliRating          Float     @default(0)
  // Stok sinyali: in_stock | low | out | unknown
  aliStockStatus     String    @default("in_stock")
  aliStockQty        Int?
  // Amazon tarafı (Keepa) — bilinmiyorsa null
  amazonBsr          Int?
  amazonSalesEst     Int?
  amazonSellerCount  Int?
  amazonSoldByAmazon Boolean   @default(false)
  // Radar
  radarScore         Int?      // 0-100
  // hot | normal | dead
  pollTier           String    @default("normal")
  // active | paused | rejected
  status             String    @default("active")
  lastScrapedAt      DateTime?
  createdAt          DateTime  @default(now())

  listings AmazonListing[]

  // ORTAK DEPO: aynı ürün Shopify kanalına da yüklenebilir (stok takibi ürün
  // başına TEK sefer yapılır, yüklendiği her kanala yansır)
  shopifyListings ShopifyListing[]

  @@index([status])
  @@index([pollTier])
}

// ─── Kullanıcı Amazon listelemeleri (hangi ürün hangi hesapta/pazarda) ────────
model AmazonListing {
  id              String   @id @default(cuid())
  userId          String
  amazonAccountId String
  productId       String
  // us | uk | ae | sa — hesabın pazarı
  market          String   @default("us")
  asin            String?  // yayınlandıktan sonra dönen ASIN
  sku             String?
  salePrice       Float?   // yerel para (pazarın birimi)
  currentQty      Int      @default(2)
  publishStage    String?
  lastError       String?
  // active | paused | ended
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amazonAccount AmazonAccount      @relation(fields: [amazonAccountId], references: [id], onDelete: Cascade)
  product       AmazonDepotProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([amazonAccountId, productId])
  @@index([userId])
  @@index([status])

  orders AmazonOrder[]
}

// ─── Amazon siparişleri + takip kodu senkronu ─────────────────────────────────
model AmazonOrder {
  id              String   @id @default(cuid())
  userId          String
  amazonAccountId String?
  listingId       String?
  // Amazon sipariş kimliği (SP-API getOrders'tan)
  amazonOrderId   String   @unique
  market          String   @default("us")
  soldPrice       Float?
  qty             Int      @default(1)
  // AliExpress tarafı
  aliOrderId      String?
  aliTrackingNo   String?  // AliExpress'in verdiği ilk numara (Amazon'da GEÇERSİZ)
  // 17track/AfterShip ile çevrilen GEÇERLİ son-mil numara
  validCarrierCode String?
  validTrackingNo  String?
  // pending | converting | converted | failed
  trackingStatus  String   @default("pending")
  // unshipped | shipped | delivered | cancelled | risk
  status          String   @default("unshipped")
  // Sipariş-anı doğrulama (canlı AliExpress stok/fiyat kontrolü)
  verifyNote      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing AmazonListing? @relation(fields: [listingId], references: [id])

  @@index([userId])
  @@index([trackingStatus])
}

// ─── ShopifyBot: mağaza hesapları + listelemeler (AliExpress → Shopify) ────────
model ShopifyAccount {
  id                   String    @id @default(cuid())
  userId               String
  // Mağazanın myshopify.com domain'i (ör. benim-magazam.myshopify.com).
  // GLOBAL tekil: aynı mağaza ikinci kez bağlanıp yeni deneme alamaz.
  shopDomain           String    @unique
  // Admin API kalıcı (offline) access token — AES-256-GCM ŞİFRELİ, düz metin ASLA
  accessTokenEncrypted String?   @db.Text
  // PAKET = HESAP (eBay EbayAccount / AmazonAccount ile aynı desen):
  // bağlanınca 7 günlük deneme ile aktif; süre bitince freeze worker'ı kapatır.
  isActive             Boolean   @default(false)
  activatedAt          DateTime?
  trialEndsAt          DateTime?
  paidUntil            DateTime?
  plan                 String    @default("starter")
  productLimit         Int       @default(300)
  // Meta entegrasyonu: müşterinin Pixel ID'si (katalog feed + pixel rehberi)
  metaPixelId          String?
  // Katalog feed'i için gizli erişim anahtarı (feed URL'i tahmin edilemesin)
  feedToken            String    @unique @default(cuid())
  // Sipariş çekme imleci: son başarılı sipariş senkronu (worker/jobs/shopify-poll-orders)
  lastOrdersSyncAt     DateTime?
  // app/uninstalled webhook'u gelince damgalanır (token da geçersizleşir)
  uninstalledAt        DateTime?
  createdAt            DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings ShopifyListing[]
  orders   ShopifyOrder[]

  @@index([userId])
}

// Kullanıcının Shopify listelemeleri — ORTAK DEPO (AmazonDepotProduct) ürününün
// Shopify kanalındaki karşılığı. AmazonListing ile aynı yaşam döngüsü:
// active | paused | ended; stok/fiyat senkronu worker'larla yürür.
model ShopifyListing {
  id               String   @id @default(cuid())
  userId           String
  shopifyAccountId String
  productId        String
  // Shopify tarafı kimlikleri (GraphQL GID formatında saklanır)
  shopifyProductId String?
  shopifyVariantId String?
  inventoryItemId  String?
  salePrice        Float?
  currentQty       Int      @default(2)
  lastError        String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopifyAccount ShopifyAccount     @relation(fields: [shopifyAccountId], references: [id], onDelete: Cascade)
  product        AmazonDepotProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopifyAccountId, productId])
  @@index([userId])
  @@index([status])
}

// Shopify mağazasına düşen siparişler. Müşteri PII'ı (isim/adres/e-posta) BURADA
// SAKLANMAZ — mağaza sahibi kargo bilgilerini kendi Shopify panelinde görür; biz
// yalnız sipariş özetini + ortak depo eşlemesini + AliExpress kaynak durumunu tutarız.
// Bu sayede customers/redact GDPR webhook'unda silinecek müşteri verimiz yoktur.
model ShopifyOrder {
  id                String   @id @default(cuid())
  userId            String
  shopifyAccountId  String
  // Shopify sipariş GID'i (gid://shopify/Order/123) — hesap içinde tekil
  shopifyOrderId    String
  name              String   // müşteriye görünen numara (#1001)
  totalPrice        Float
  currency          String   @default("USD")
  financialStatus   String?
  fulfillmentStatus String?
  // [{title, quantity, shopifyProductId, listingId?, depotProductId?}]
  lineItems         Json
  // Sipariş-anı kaynak kontrolü (ortak depo verisinden): ok | ali_stock_risk | unlinked
  sourcingStatus    String   @default("ok")
  // Eşleşen kalemlerin AliExpress maliyeti (ürün+kargo, adetle çarpılı toplam)
  aliCostUsd        Float?
  shopifyCreatedAt  DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopifyAccount ShopifyAccount @relation(fields: [shopifyAccountId], references: [id], onDelete: Cascade)

  @@unique([shopifyAccountId, shopifyOrderId])
  @@index([userId, shopifyCreatedAt])
}

// ─── Kredi cüzdanı hareketleri (audit ledger) ─────────────────────────────────
model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  // Negatif = harcama, pozitif = yükleme/iade (USD)
  amountUsd Float
  // topup | tracking_conversion | refund
  type      String
  refId     String?  // ör. AmazonOrder.id
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Kullanıcıya Dağıtılan Ürünler ──────────────────────────────────────────
model ProductDistribution {
  id             String   @id @default(cuid())
  userId         String
  depotProductId String
  listingId      String?  @unique
  distributedAt  DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  depotProduct DepotProduct @relation(fields: [depotProductId], references: [id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [listingId], references: [id])

  @@unique([userId, depotProductId])
}

// ─── Kupon (indirim/bonus gün kodları) ──────────────────────────────────────
// Kupon kullanılınca kullanıcının referralRewardDays bakiyesine bonus gün ekler.
// (Sosyal medyada "ILK50" gibi kodlar paylaşılır.)
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  rewardDays  Int                              // kullanıcıya eklenen bonus gün
  maxUses     Int?                             // null = sınırsız
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
}

// ─── Admin Bildirimleri (bakiye uyarıları vb.) ──────────────────────────────
// Kullanıcı kredi cüzdanı bitince/azalınca admin panele düşer. Kritik: bakiye
// biterse tracking dönüşümü yapılamaz → sipariş geçerli kargosuz kalır → eBay riski.
model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // balance_empty | balance_low | ...
  title     String
  message   String
  userId    String?  // ilgili kullanıcı (varsa)
  userEmail String?  // hızlı gösterim için anlık kopya
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([type, userId, isRead])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MEVCUT İLAN İÇE AKTARMA (Listing Import)
// Satıcı eBay mağazasını bağlayınca, başka araçla/elle açtığı TÜM mevcut ilanları
// (10k–100k olabilir) sisteme çekeriz; SKU'daki ASIN üzerinden Amazon'a eşleştirir,
// SADECE "confirmed" (SIFIR HATA) olanları stok takibine alırız. Hiçbir şey otomatik
// fiyatlanmaz; satıcı "takibi aç" demeden önce her şey GÖLGE (shadow) modundadır.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Bir import çalışması (mağaza başına; ilerleme + sayaçlar + devam imleci) ──
model ListingImport {
  id            String    @id @default(cuid())
  userId        String
  ebayAccountId String
  // pending | fetching | matching | completed | failed | cancelled
  status        String    @default("pending")
  // Hangi eBay kaynağından çekildi: getmyebayselling | getsellerlist | feed | inventory
  source        String    @default("getmyebayselling")
  // Sayaçlar
  totalListings     Int @default(0)
  processedListings Int @default(0)
  confirmedCount    Int @default(0)
  reviewCount       Int @default(0)
  unmatchedCount    Int @default(0)
  // Devam edebilir sayfalama imleci (çekme yarıda kesilirse buradan sürer)
  pageCursor    Int?
  totalPages    Int?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccount EbayAccount @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)

  @@index([ebayAccountId, status])
  @@index([userId, status])
}

// ─── İçe aktarılan tek bir eBay ilanı + eşleşme kararı + takip kontrolü ───────
model ImportedListing {
  id            String @id @default(cuid())
  userId        String
  ebayAccountId String
  // eBay tarafı (GetMyeBaySelling / GetSellerList'ten)
  ebayItemId    String  // eBay ItemID (mağaza içinde benzersiz)
  ebaySku       String? // satıcının SKU'su — ASIN buradan ayıklanır
  title         String?
  price         Float?
  currency      String  @default("USD")
  quantity      Int?
  imageUrl      String?
  ebaySite      String  @default("EBAY_US")

  // ── Eşleştirme (SIFIR HATA motoru) ──
  detectedAsin   String? // SKU'dan ayıklanan ASIN (yoksa null)
  amazonMarket   String  @default("US")
  // confirmed | review | unmatched | pending
  matchStatus    String  @default("pending")
  matchConfidence Float  @default(0)
  matchReason    String?

  // ── Takip kontrolü (GÖLGE modu) ──
  // false → hiçbir otomatik fiyat/stok işlemi yapılmaz. Satıcı açıkça açana kadar bekler.
  trackingEnabled Boolean @default(false)
  // Onaylanıp takip açılınca oluşturulan/eşlenen kayıtlar
  linkedProductId String?
  linkedListingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccount   EbayAccount  @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)
  linkedProduct Product?     @relation(fields: [linkedProductId], references: [id], onDelete: SetNull)

  // Aynı ilan iki kez içe aktarılmasın (idempotent re-import)
  @@unique([ebayAccountId, ebayItemId])
  @@index([userId, matchStatus])
  @@index([ebayAccountId, matchStatus])
  @@index([matchStatus, trackingEnabled])
}
