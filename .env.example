# ─── Veritabanı ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ebay_user:ebay_pass@localhost:5432/ebay_db"

# ─── Redis (BullMQ worker) ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Token Şifreleme (Node crypto — AES-256-GCM) ─────────────────────────────
# 64 hex karakter = 32 byte anahtar
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# ─── Cron Job Güvenliği ───────────────────────────────────────────────────────
# Üret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ─── ScrapingBee (Amazon veri çekici) ────────────────────────────────────────
# Kayıt: https://www.scrapingbee.com — ücretsiz 1000 istek
SCRAPINGBEE_API_KEY=""

# ─── eBay Developer Credentials ──────────────────────────────────────────────
# Kayıt: https://developer.ebay.com — ücretsiz
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_REDIRECT_URI="http://localhost:3000/api/ebay/callback"
EBAY_SANDBOX="true"

# eBay Webhook doğrulama token'ı (developer.ebay.com'dan al)
EBAY_WEBHOOK_VERIFICATION_TOKEN=""

# eBay Seller ayarları (sandbox/production'da oluştur)
# Sandbox'ta: developer.ebay.com → Test User → Seller Profile
EBAY_FULFILLMENT_POLICY_ID=""
EBAY_PAYMENT_POLICY_ID=""
EBAY_RETURN_POLICY_ID=""
EBAY_MERCHANT_LOCATION_KEY=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Kayıt: https://dashboard.stripe.com
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Fiyat ID'leri (dashboard.stripe.com → Products → fiyat oluştur)
STRIPE_PRICE_PRO_ID=""
STRIPE_PRICE_ENTERPRISE_ID=""

# ─── EtsyFlow Köprüsü (Etsy otomasyonu EtsyFlow Supabase'inde döner) ─────────
# Supabase Dashboard → Project Settings → API
# URL = Project URL,  SERVICE_KEY = service_role secret (RLS bypass — GİZLİ!)
# SADECE sunucu tarafı kullanılır, asla NEXT_PUBLIC yapma.
ETSYFLOW_SUPABASE_URL="https://fboqgujtgtfadsmcuuxp.supabase.co"
ETSYFLOW_SUPABASE_SERVICE_KEY=""
# EtsyFlow canlı adresi ("EtsyFlow'da Yönet" butonu buraya gider) — build-time
NEXT_PUBLIC_ETSYFLOW_URL="https://etsy-flow.vercel.app"

# ─── AmazonBot: AliExpress Open Platform (Dropshipper API) ───────────────────
# Başvuru: https://openservice.aliexpress.com → uygulama oluştur → Dropshipping API izni
# Access token OAuth ile alınır (onay sonrası birlikte hallederiz).
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_ACCESS_TOKEN=""
ALIEXPRESS_REFRESH_TOKEN=""

# ─── AmazonBot: Keepa (Amazon talep/BSR verisi — radar) ──────────────────────
KEEPA_API_KEY=""

# ─── AmazonBot: SP-API (Amazon listeleme + pazar tespiti + marka kısıtı) ─────
# LWA = Login with Amazon (SP-API uygulaması). Solutions Provider hesabı gerekir.
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
# Mağaza bağlama (consent) akışı için:
AMAZON_SPAPI_APP_ID=""
AMAZON_SPAPI_REDIRECT_URI="https://lean-automation.com/api/amazon/callback"

# ─── SEO / Site ───────────────────────────────────────────────────────────────
# Gerçek alan adı alınınca doldur (sitemap, robots, canonical, OG için)
NEXT_PUBLIC_SITE_URL="https://lean-automation.com"

# ─── Uygulama ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
