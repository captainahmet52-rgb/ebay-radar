{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "index.ts",
    "jobs/**/*.ts",
    "../src/lib/queues.ts",
    "../src/lib/prisma.ts",
    "../src/lib/crypto.ts",
    "../src/lib/scraper.ts",
    "../src/lib/repricer.ts",
    "../src/lib/auto-upload-schedule.ts",
    "../src/types/index.ts"
  ]
}
