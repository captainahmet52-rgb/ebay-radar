{
  "manifest_version": 3,
  "name": "Lean Automation — Amazon ASIN Grabber",
  "version": "0.4.0",
  "description": "Amazon'da kârlı ürünleri filtrele ve ASIN'leri topla. Tek tık kopyala, Lean Automation paneline toplu yapıştır. Sadece ASIN toplama — başka hiçbir şey yapmaz.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.com.tr/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Lean Automation — ASIN Grabber"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.com.tr/*"
      ],
      "js": ["content/amazon.js"],
      "css": ["content/amazon.css"],
      "run_at": "document_end"
    }
  ]
}
